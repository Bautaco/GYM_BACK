# Puerto del servidor backend
PORT=3000

# Secreto para JWT
JWT_SECRET=gym_super_secret_jwt_key_2026

# Tipo de base de datos: 'sqlite' o 'postgres'
DATABASE_TYPE=sqlite
DB_DATABASE=gym.sqlite

# Configuración si se usa PostgreSQL:
# DATABASE_TYPE=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=postgres
# DB_PASSWORD=postgres
# DB_NAME=gym_db
